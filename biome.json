{
  "$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
  "extends": ["socle-ui/biome"],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "scripts/**",
      "*.json",
      "*.ts",
      "!src/lib/databaseBindings.ts",
      "!pnpm-lock.yaml"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.test.ts", "**/*.test.tsx", "**/*.test-helper.ts", "tests/**"],
      "linter": {
        "rules": {
          "style": {
            "noNonNullAssertion": "off"
          }
        }
      }
    },
    {
      "includes": ["src/ui/components/DataTable.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noRedundantRoles": "off",
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      "includes": [
        "src/ui/**",
        "src/features/agent/Activities.tsx",
        "src/features/agent/AgentPage.tsx",
        "src/features/agent/AgentSendButton.tsx",
        "src/features/agent/Composer.tsx",
        "src/features/agent/QueueList.tsx",
        "src/features/agent/TextPreview.tsx",
        "src/features/agent/Transcript.tsx",
        "src/features/agent/transcript/ImagePreview.tsx",
        "src/features/agent/transcript/PageCaptures.tsx",
        "src/features/agent/uiFix.tsx",
        "src/features/functions/FunctionParts.tsx",
        "src/features/functions/ModuleFunctions.tsx",
        "src/features/modules/MarketplaceSources.tsx",
        "src/features/modules/dialogs.tsx",
        "src/features/modules/reorganize.tsx",
        "src/features/setup/Onboarding.tsx",
        "src/features/space/SpaceSwitcher.tsx",
        "src/features/vault/SecretReveal.tsx",
        "src/features/vault/VaultEntryDialog.tsx",
        "src/runtime/screenshotPage.ts",
        "src/shell/AppShell.tsx",
        "src/shell/MenuZone.tsx",
        "src/shell/NotificationCenter.tsx",
        "src/shell/TopBarSearch.tsx",
        "src/shell/navigationEditing.tsx"
      ],
      "linter": {
        "enabled": false
      }
    }
  ]
}
